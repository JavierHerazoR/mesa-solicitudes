{
  "name": "mesa-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Gestión de solicitudes, seguimiento y reportes. Proyecto de portafolio full stack.",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:client": "vite --host 127.0.0.1",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.json && vite build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json",
    "test": "npm run build:server && node --test tests/*.test.cjs",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "lucide-react": "0.545.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "22.14.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.1.3",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "supertest": "7.1.3",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  }
}
